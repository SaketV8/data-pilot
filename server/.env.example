# Get key from here 
# https://build.nvidia.com/nvidia/nemotron-3.5-super-vl-120b-a12b

NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

LLM_PROVIDER=nim
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

LLM_TEMPERATURE=0
LLM_TOP_P=1
LLM_MAX_TOKENS=4096
# Shown against the per-minute LLM call count in the UI (not enforced).
LLM_RATE_LIMIT_PER_MINUTE=40

# The TanStack Start dev server runs on port 3000 (see client/package.json).
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=25
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=1000
